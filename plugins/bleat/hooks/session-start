#!/usr/bin/env bash
# SessionStart hook for the bleat plugin: prints the just-bleat-it dispatch
# mandate to stdout, which Claude Code injects as session context directly.
# A missing context file fails the hook cleanly instead of injecting noise.
# @VERSION@ becomes the plugin's version, which opening-a-pr stamps into PR bodies.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(sed -n 's/^ *"version" *: *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json")"
sed "s/@VERSION@/${version:-unknown}/g" "$root/hooks/session-start-context.md"
